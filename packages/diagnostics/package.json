{
  "name": "@dudousxd/nestjs-durable-diagnostics",
  "version": "0.3.0",
  "description": "Aviary diagnostics bus integration for nestjs-durable — every run/step event on aviary:durable:*",
  "license": "MIT",
  "author": "Davide Carvalho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-durable.git",
    "directory": "packages/diagnostics"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/durable",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-durable/issues"
  },
  "keywords": [
    "nestjs",
    "durable",
    "diagnostics"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-durable-core": ">=0.1.0 <1.0.0",
    "@dudousxd/nestjs-diagnostics": ">=0.3.0 <1.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dudousxd/nestjs-diagnostics": "0.9.0",
    "@dudousxd/nestjs-durable": "workspace:^",
    "@dudousxd/nestjs-durable-core": "workspace:^",
    "@dudousxd/nestjs-durable-dashboard": "workspace:^",
    "@dudousxd/nestjs-durable-store-typeorm": "workspace:^",
    "@dudousxd/nestjs-durable-transport-db": "workspace:^",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@testcontainers/postgresql": "10.18.0",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "tsup": "8.3.5",
    "typeorm": "0.3.31",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vite-node": "2.1.9"
  },
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./delivery": {
      "import": {
        "types": "./dist/delivery/index.d.ts",
        "default": "./dist/delivery/index.js"
      },
      "require": {
        "types": "./dist/delivery/index.d.cts",
        "default": "./dist/delivery/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=24"
  }
}
