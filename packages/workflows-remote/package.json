{
  "name": "@dudousxd/nestjs-durable-workflows-remote",
  "version": "0.0.0",
  "description": "Remote steps for the official @nestjs/workflows engine: run a step on a nestjs-durable worker (Node or Python) over durable’s transports, without holding the instance’s lease",
  "license": "MIT",
  "author": "Davide Carvalho",
  "repository": {
    "type": "git",
    "url": "https://github.com/DavideCarvalho/nestjs-durable.git",
    "directory": "packages/workflows-remote"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/durable",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-durable/issues"
  },
  "keywords": [
    "nestjs",
    "durable",
    "workflows",
    "remote-steps"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-durable-core": ">=0.1.0 <1.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/workflows": ">=0.0.5 <0.1.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.1.0"
  },
  "devDependencies": {
    "@dudousxd/durable-worker": "workspace:*",
    "@dudousxd/nestjs-durable-core": "workspace:^",
    "@dudousxd/nestjs-durable-transport-event-emitter": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@nestjs/workflows": "0.0.5",
    "eventemitter2": "6.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsup": "8.3.5",
    "typescript": "5.9.3"
  }
}
