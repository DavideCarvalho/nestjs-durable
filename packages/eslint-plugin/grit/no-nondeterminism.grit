// Biome (>= 2.0) GritQL plugin: flag non-deterministic sources that corrupt a durable replay.
// Scope it to your workflow files via biome.json `plugins` (or an override that includes
// "**/*.workflow.ts"). Only the `run` method body — the replayed orchestration body — is checked, so
// co-located @Step / @DeadLetter methods in the SAME file are NOT flagged: an @Step runs once on a
// worker and is checkpointed, so `new Date()`/`Math.random()` there is replay-safe. Calls inside a
// ctx.sideEffect(...) / ctx.task(...) callback are likewise skipped — those bodies run once and are
// checkpointed. In the orchestration body, use ctx.now() / ctx.sideEffect(fn) instead.
language js

or {
  `Date.now()`,
  `performance.now()`,
  `Math.random()`,
  `crypto.randomUUID()`,
  `globalThis.crypto.randomUUID()`,
  `new Date()`
} as $bad where {
  // Only the workflow's `run` body replays; scope the rule to it so co-located @Step/@DeadLetter
  // methods (their bodies run once, off the replay path) don't trip a false positive.
  $bad <: within `run($...) { $... }`,
  not $bad <: within `$_.sideEffect($...)`,
  not $bad <: within `$_.task($...)`,
  register_diagnostic(
    span = $bad,
    message = "Non-deterministic source in a durable workflow body — it differs across replays and corrupts the run. Use ctx.now() / ctx.sideEffect(fn) (or move it inside a ctx.sideEffect, which is checkpointed)."
  )
}
